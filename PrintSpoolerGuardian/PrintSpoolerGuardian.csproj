<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 7 SP1 includes .NET Framework 3.5.1. Target it so the app
         has no separately-installed runtime prerequisite. -->
    <TargetFramework>net35</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PrintSpoolerGuardian</AssemblyName>
    <RootNamespace>PrintSpoolerGuardian</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Do not treat generated publish DLLs as source items or build references. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**</DefaultItemExcludes>

    <!-- Version info -->
    <Version>2.2.0.0</Version>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
    <Product>Print Spooler Guardian</Product>
    <Description>Zero-config USB &amp; shared printer monitoring and auto-recovery for Windows</Description>
    <Copyright>Copyright © BobanAliBrz 2025-2026</Copyright>
    <Company>BobanAliBrz</Company>

  </PropertyGroup>

  <ItemGroup>
    <!-- Framework assemblies present in Windows 7's built-in .NET 3.5.1. -->
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!-- Enables net35 builds on machines without local .NET Framework reference assemblies. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <!-- Bootstrapper is excluded from the main build. -->
  <ItemGroup>
    <Compile Remove="Bootstrapper\**" />
    <EmbeddedResource Remove="Bootstrapper\**" />
  </ItemGroup>
</Project>
