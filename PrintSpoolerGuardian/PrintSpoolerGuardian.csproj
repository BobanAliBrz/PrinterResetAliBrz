<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PrintSpoolerGuardian</AssemblyName>
    <RootNamespace>PrintSpoolerGuardian</RootNamespace>
    <LangVersion>latest</LangVersion>

    <!-- Version info -->
    <Version>2.0.2.0</Version>
    <AssemblyVersion>2.0.2.0</AssemblyVersion>
    <FileVersion>2.0.2.0</FileVersion>
    <Product>Print Spooler Guardian</Product>
    <Description>Zero-config USB &amp; shared printer monitoring and auto-recovery for Windows</Description>
    <Copyright>Copyright © BobanAliBrz 2025-2026</Copyright>
    <Company>BobanAliBrz</Company>

    <!-- Self-contained: bundles the entire .NET runtime so target PCs need ZERO prerequisites.
         No .NET Framework download, no waiting — just install and run. -->
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Partial trimming is safer — only trims assemblies that opted in.
         Full trimming can break WMI (System.Management) and WinForms reflection. -->
    <TrimMode>partial</TrimMode>
    <!-- WinForms is safe with partial trim — suppress the blanket SDK error -->
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet packages (these replace the old net48 framework references) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>

  <!-- Prevent the trimmer from removing assemblies that use reflection heavily -->
  <ItemGroup>
    <TrimmerRootAssembly Include="System.Management" />
    <TrimmerRootAssembly Include="System.Configuration.ConfigurationManager" />
  </ItemGroup>

  <!-- Bootstrapper is dead — excluded from build -->
  <ItemGroup>
    <Compile Remove="Bootstrapper\**" />
    <EmbeddedResource Remove="Bootstrapper\**" />
  </ItemGroup>
</Project>
