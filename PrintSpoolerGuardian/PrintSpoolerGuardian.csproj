<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PrintSpoolerGuardian</AssemblyName>
    <RootNamespace>PrintSpoolerGuardian</RootNamespace>
    <LangVersion>latest</LangVersion>

    <!-- Version info -->
    <Version>1.2.1.0</Version>
    <AssemblyVersion>1.2.1.0</AssemblyVersion>
    <FileVersion>1.2.1.0</FileVersion>
    <Product>Print Spooler Guardian</Product>
    <Description>Zero-config USB &amp; shared printer monitoring and auto-recovery for Windows</Description>
    <Copyright>Copyright © BobanAliBrz 2025-2026</Copyright>
    <Company>BobanAliBrz</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- These are framework assemblies shipped with .NET Framework 4.8 (no NuGet package needed).
         Using the framework assemblies (instead of NuGet) avoids runtime-loading issues on bare Win7. -->
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Xml" />
    <!-- Required for `dynamic` (COM interop in Program.cs) on net48 -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- Allows building net48 on dev machines that don't have the framework reference
       assemblies installed locally (SDK restores them automatically). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
  </ItemGroup>

  <!-- Bootstrapper is a separate project - exclude from main build -->
  <ItemGroup>
    <Compile Remove="Bootstrapper\**" />
    <EmbeddedResource Remove="Bootstrapper\**" />
  </ItemGroup>
</Project>
