<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PrintSpoolerGuardian</AssemblyName>
    <RootNamespace>PrintSpoolerGuardian</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Do not treat generated publish DLLs as source items or build references. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**</DefaultItemExcludes>

    <!-- Version info -->
    <Version>2.1.0.0</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <Product>Print Spooler Guardian</Product>
    <Description>Zero-config USB &amp; shared printer monitoring and auto-recovery for Windows</Description>
    <Copyright>Copyright © BobanAliBrz 2025-2026</Copyright>
    <Company>BobanAliBrz</Company>

  </PropertyGroup>

  <ItemGroup>
    <!-- Framework assemblies: using these avoids runtime-loading issues on Win7. -->
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- Enables net48 builds on machines without local .NET Framework reference assemblies. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <!-- Bootstrapper is excluded from the main build. -->
  <ItemGroup>
    <Compile Remove="Bootstrapper\**" />
    <EmbeddedResource Remove="Bootstrapper\**" />
  </ItemGroup>
</Project>
